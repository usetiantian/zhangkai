{
  "name": "music3-studio",
  "productName": "music3 音乐工作室",
  "version": "1.0.0",
  "description": "一句话生成音乐 · 本地 MiniMax Music3",
  "main": "electron/main.js",
  "author": "music3",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:dir": "electron-builder --win --dir",
    "build:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.music3.studio",
    "productName": "music3 音乐工作室",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["electron/**/*", "ui/**/*", "LICENSE", "THIRD-PARTY-NOTICES.md"],
    "win": {
      "target": [{"target": "nsis", "arch": ["x64"]}],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "music3 音乐工作室"
    },
    "mac": { "target": "dmg", "category": "public.app-category.music" }
  }
}
